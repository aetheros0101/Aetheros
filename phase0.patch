-        """
-        WASM dosyasından task gönder.
-        Dosyayı okuyup hex'e çevirir.
-        """
-        with open(wasm_path, "rb") as f:
-            wasm_bytes = f.read()
-        wasm_hex = wasm_bytes.hex()
-        return await self.submit_task(
-            entrypoint, wasm_hex, **kwargs
-        )
-
-    async def task_state(
-        self,
-        task_id: str | UUID,
