-            if coordinator.cancelled()
-            {
-                return Err(
-                    RuntimeError::Shutdown,
-                );
-            }
-
-            let ready =
-                coordinator
-                    .ready_nodes(
-                        &graph,
-                    );
-
-            if ready.is_empty() {
-                break;
-            }
-
-            let executable:
-                Vec<
-                    ExecutionNode,
-                > = graph
-                .nodes
-                .iter()
-                .filter(|node| {
-                    ready.contains(
-                        &node.id,
-                    )
-                })
-                .cloned()
-                .collect();
-
-            let mut handles:
-                Vec<
-                    JoinHandle<
-                        Result<
-                            Uuid,
-                            RuntimeError,
-                        >,
-                    >,
-                > = Vec::new();
-
-            for node in executable {
-                let handle =
-                    tokio::spawn(
-                        async move {
-                            Ok(node.id)
-                        },
-                    );
-
-                handles.push(
-                    handle,
-                );
-            }
-
-            let results =
-                join_all(handles)
-                    .await;
-
-            for result in results {
-                let node_id =
-                    result
-                        .map_err(
-                            |_| {
-                                RuntimeError::TaskExecutionFailed {
-                                    message:
-                                        "execution join failure"
-                                            .into(),
-                                }
-                            },
-                        )??;
