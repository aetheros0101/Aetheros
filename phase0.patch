-echo ""
-echo -e "  Toplam süre   : ${ELAPSED}s"
-echo -e "  RAM (şimdi)   : $(ram_mb) MB"
-echo ""
-echo -e "  ${GREEN}PASSED : ${PASS}${NC}"
