-else
-  echo -e "${BOLD}${RED}  ❌ ${FAIL} test başarısız${NC}"
-fi
-
-echo ""
-
-# Temizlik
-rm -f "$LATENCY_FILE" "$TASK_ID_FILE"
-
-exit $(( FAIL > 0 ? 1 : 0 ))
